# IP-SAKTI Sahayak Environment Variables

# --- GEMINI EMBEDDINGS ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- VECTOR DB (QDRANT CLOUD) ---
QDRANT_CLUSTER_ENDPOINT=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# --- LLM (GROQ) ---
GROQ_API_KEY=your_groq_api_key_here

# Available free Groq models:
# - mixtral-8x7b-32768 (recommended for speed + quality)
# - llama2-70b-4096 (good for complex reasoning)
# - llama-3.1-70b-versatile (newest, best accuracy)
# - gemma-7b-it (lightweight)
GROQ_MODEL=mixtral-8x7b-32768
GROQ_FALLBACK_MODEL=llama2-70b-4096
GROQ_GUARDRAIL_MODEL=mixtral-8x7b-32768

# --- LLM GATEWAY (PORTKEY) ---
PORTKEY_API_KEY=your_portkey_key_here

# --- OBSERVABILITY ---
LOGFIRE_TOKEN=your_logfire_key_here
LOGFIRE_IGNORE_NO_CONFIG=1

# --- MULTILINGUAL (OPTIONAL) ---
BHASHINI_API_URL=your_bhashini_url_optional
BHASHINI_ENDPOINT=your_bhashini_url_optional
BHASHINI_API_KEY=your_bhashini_key_optional

# --- LANGSMITH (OPTIONAL) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key_optional
LANGSMITH_PROJECT=ip-sakti-sahayak

# --- DEBUG MODE ---
DEBUG=false
